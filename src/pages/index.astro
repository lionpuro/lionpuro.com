---
import Layout from "$layouts/Layout.astro";
import { SITE_NAME, ROUTES, SOCIAL_LINKS } from "$config";
---

<Layout
	route={ROUTES.home}
	title={SITE_NAME}
	description="Software developer from Finland"
>
	<div class="my-auto flex flex-col justify-center pb-22">
		<div class="flex max-w-xl flex-col">
			<div class="flex flex-col mb-4">
				<h1 class="text-2xl font-bold">Lion Puro</h1>
				<div class="flex items-center gap-2 text-sm font-medium">
					<a
						href={SOCIAL_LINKS.github_url}
						aria-label="github"
						target="_blank"
						rel="noopener noreferrer"
						class="underline text-muted-foreground hover:text-foreground"
					>
						github
					</a>
					<a
						href={SOCIAL_LINKS.linkedin_url}
						aria-label="linkedin"
						target="_blank"
						rel="noopener noreferrer"
						class="underline text-muted-foreground hover:text-foreground"
					>
						linkedin
					</a>
				</div>
			</div>
			<p class="text-muted-foreground">
				Hello, I'm Lion. I'm a <strong>software developer</strong> mainly focused
				on web development. Here you can find some of the stuff I've been working
				on.
			</p>
		</div>
	</div>
</Layout>
